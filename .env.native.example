# Copy this into .env and replace secrets before deployment.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
# Local development:
DATABASE_URL=sqlite:///./dpdp.db
# Production: use PostgreSQL, e.g. postgresql+psycopg://verity:YOUR_PASSWORD@127.0.0.1:5432/verity
# DATABASE_URL=sqlite:///./dpdp.db
CORS_ORIGINS=https://example.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Website scanner (optional). SCAN_MODE: auto (browser, falling back to static) | browser | static
# SCAN_MODE=auto
# SCAN_MAX_PAGES=10
# SCAN_TIME_BUDGET=45
# SCAN_BROWSER_SLOTS=2
# SCAN_ANY_HOST=false   (true lets users scan domains other than the organisation's registered site)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
