[Unit]
Description=Verity DPDP FastAPI service
After=network.target postgresql.service
[Service]
Type=simple
User=verity
Group=verity
WorkingDirectory=/opt/verity-dpdp/backend
EnvironmentFile=/opt/verity-dpdp/.env
ExecStart=/opt/verity-dpdp/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
